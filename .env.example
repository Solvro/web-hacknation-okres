# Puste: kontener wygeneruje klucz raz i zapisze go na wolumenie danych
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost
# 1 = tryb demonstracyjny (zegar, dane syntetyczne, szybkie logowanie); w urzędzie 0
OKRES_DEMO=0
# Poczta (opcjonalnie): serwer SMTP urzędu i powiadomienia e-mail ze schedulera
OKRES_SMTP_HOST=
OKRES_SMTP_PORT=25
OKRES_POWIADOMIENIA_EMAIL=0
# Produkcja za reverse proxy z TLS (np. Coolify/Traefik)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_PROXY=0
# Baza: domyślnie SQLite w OKRES_DATA_DIR; duży urząd może podać DATABASE_URL
# DATABASE_URL=
# W trybie demo: wczytaj dane syntetyczne lub uzupełnij starszą bazę demo (1/0)
OKRES_SEED_ON_START=1
# Asystent AI (opcjonalny): wylaczone | ollama (model lokalny w sieci urzędu)
OKRES_AI=wylaczone
# Ollama na hoście przy docker compose: http://host.docker.internal:11434
OKRES_OLLAMA_URL=http://localhost:11434
# Model w Ollamie; alternatywa: hf.co/speakleash/Bielik-11B-v3.1-Instruct-GGUF:Q4_K_M
OKRES_AI_MODEL=gemma4:12b
# Tryb rozumowania modelu: 0 = wyłączony (domyślnie), 1 = włączony
OKRES_AI_THINK=0
